# CognitiveOS Genesis - Environment Variables Example
# Copy this file to .env and configure as needed

# Genesis Configuration
GENESIS_LOG_LEVEL=INFO
GENESIS_REGISTRY_PATH=capabilities/registry

# Development Settings
GENESIS_DEV_MODE=true

# Testing
GENESIS_TEST_MODE=false

# Future: Model Provider Configuration (v0.4+)
# GENESIS_MODEL_PROVIDER=mock
# GENESIS_MODEL_API_KEY=

# Future: Remote Registry Configuration (v0.2+)
# GENESIS_REMOTE_REGISTRY_URL=
# GENESIS_REMOTE_REGISTRY_TOKEN=

# Security
GENESIS_APPROVAL_REQUIRED=true
GENESIS_DENY_BY_DEFAULT=true

# Observability
GENESIS_EVENT_LOG_PATH=logs/events.jsonl
GENESIS_STRUCTURED_LOGGING=true

# DO NOT COMMIT .env FILE
# Add .env to .gitignore
